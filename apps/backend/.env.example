# Sahm Backend — Environment Variables (Development)
# DO NOT commit this file to version control

# App
APP_NAME="Sahm API"
APP_VERSION="0.1.0"
DEBUG=true

# Database
DATABASE_URL="postgresql+asyncpg://sahm_user:sahm_dev_password@localhost:5432/sahm"
DATABASE_ECHO=false

# JWT Auth
SECRET_KEY="sahm-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL="redis://localhost:6379/0"

# Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=20

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'
